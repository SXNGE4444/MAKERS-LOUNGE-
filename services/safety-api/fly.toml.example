# Copy to fly.toml and replace the app name before deploying.
app = "travel-safe-safety-api"
primary_region = "jnb"

[build]
  dockerfile = "Dockerfile"

[http_service]
  internal_port = 8090
  force_https = true
  auto_start_machines = true
  auto_stop_machines = "stop"
  min_machines_running = 1
  processes = ["app"]

  [[http_service.checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "10s"
    method = "GET"
    path = "/api/travel-safe/v1/health"

[mounts]
  source = "pb_data"
  destination = "/pb/pb_data"
  auto_extend_size_threshold = 80
  auto_extend_size_increment = "1GB"
  auto_extend_size_limit = "10GB"

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory = "512mb"
